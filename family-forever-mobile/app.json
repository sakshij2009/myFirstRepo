{
  "expo": {
    "name": "Family Forever App",
    "slug": "family-forever-mobile",
    "version": "4.0.2",
    "orientation": "portrait",
    "scheme": "familyforevermobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "projectName": "FamilyForeverApp",
      "supportsTablet": false,
      "bundleIdentifier": "com.familyforever.staffapp",
      "buildNumber": "13",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app needs access to the camera to update your profile photo.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select a profile picture.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location only while the app is open and you are actively clocked in to a shift, to record your clock-in and clock-out location for payroll accuracy.",
        "UIBackgroundModes": [
          "fetch"
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.famforever.admin",
      "versionCode": 11
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This app uses your location only while the app is open and you are actively clocked in to a shift, to record your clock-in and clock-out location for payroll accuracy."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photo library to select a profile picture.",
          "cameraPermission": "This app needs access to the camera to update your profile photo."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "notification": {
      "icon": "./assets/logo.png",
      "color": "#1f5f3b"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c407037-f5ca-4cd1-8746-b8bca799467d"
      }
    }
  }
}
